---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
if (steps.length === 0) return null;
---

<div class="pipeline reveal" aria-label="分析链路">
  <span class="pipeline__label">链路</span>
  <ol class="pipeline__steps">
    {steps.map((step) => (
      <li>{step}</li>
    ))}
  </ol>
</div>

<style>
  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.75rem;
    padding: 0.95rem 1.1rem;
    background: var(--color-bg);
    border: none;
    border-radius: 14px;
  }

  .pipeline__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  .pipeline__steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipeline__steps li {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    opacity: 0;
    transform: translateY(4px);
    animation: step-in 0.4s ease forwards;
  }

  .pipeline__steps li:nth-child(1) {
    animation-delay: 0.05s;
  }
  .pipeline__steps li:nth-child(2) {
    animation-delay: 0.12s;
  }
  .pipeline__steps li:nth-child(3) {
    animation-delay: 0.19s;
  }
  .pipeline__steps li:nth-child(4) {
    animation-delay: 0.26s;
  }
  .pipeline__steps li:nth-child(5) {
    animation-delay: 0.33s;
  }
  .pipeline__steps li:nth-child(6) {
    animation-delay: 0.4s;
  }

  .pipeline__steps li:not(:last-child)::after {
    content: '→';
    margin-left: 0.5rem;
    color: #5eead4;
    font-weight: 400;
  }

  .pipeline.is-visible .pipeline__steps li:last-child {
    color: var(--color-accent);
  }

  @keyframes step-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipeline__steps li {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
