---
interface Metric {
  label: string;
  value: string;
  hint?: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
<ul class="metrics reveal" aria-label="关键指标">
  {
    metrics.map((m) => (
      <li class="metrics__item">
        <span class="metrics__value">{m.value}</span>
        <span class="metrics__label">{m.label}</span>
        {m.hint && <span class="metrics__hint">{m.hint}</span>}
      </li>
    ))
  }
</ul>
  )
}

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.75rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .metrics__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .metrics.is-visible .metrics__item {
    animation: metric-in 0.45s ease both;
  }

  .metrics.is-visible .metrics__item:nth-child(1) {
    animation-delay: 0.05s;
  }
  .metrics.is-visible .metrics__item:nth-child(2) {
    animation-delay: 0.12s;
  }
  .metrics.is-visible .metrics__item:nth-child(3) {
    animation-delay: 0.19s;
  }
  .metrics.is-visible .metrics__item:nth-child(4) {
    animation-delay: 0.26s;
  }

  .metrics__item:hover {
    border-color: #99f6e4;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgb(13 148 136 / 10%);
  }

  .metrics__value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
  }

  @keyframes metric-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .metrics.is-visible .metrics__item {
      animation: none;
    }
  }

  .metrics__label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .metrics__hint {
    font-size: 0.72rem;
    color: var(--color-muted);
  }
</style>
