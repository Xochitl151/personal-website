---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Stop {
  href: string;
  title: string;
  blurb: string;
}

interface Props {
  pageTitle: string;
  description: string;
  heading: string;
  summary: string;
  stops: Stop[];
  otherHref: string;
  otherLabel: string;
}

const { pageTitle, description, heading, summary, stops, otherHref, otherLabel } = Astro.props;
---

<BaseLayout title={pageTitle} description={description}>
  <section class="pitch">
    <div class="container pitch__inner">
      <p class="pitch__eyebrow">作品精选</p>
      <h1>{heading}</h1>
      <p class="lead">{summary}</p>
      <p class="pitch__rule">
        <slot name="rule" />
      </p>

      <ol class="pitch__list">
        {
          stops.map((stop, i) => (
            <li class="pitch__card">
              <span class="pitch__n">{i + 1}</span>
              <div>
                <h2>
                  <a href={stop.href}>{stop.title}</a>
                </h2>
                <p>{stop.blurb}</p>
                <a class="pitch__go" href={stop.href}>
                  打开 →
                </a>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="pitch__foot">
        其他方向：
        <a href={otherHref}>{otherLabel}</a>
        ·
        <a href="/resume">下载简历</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pitch {
    padding-block: var(--space-section);
  }

  .pitch__inner {
    max-width: 40rem;
  }

  .pitch__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lead {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .pitch__rule {
    margin: 0 0 1.75rem;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .pitch__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pitch__card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .pitch__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: var(--color-accent);
    border-radius: 999px;
  }

  .pitch__card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .pitch__card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .pitch__card h2 a:hover {
    color: var(--color-accent);
  }

  .pitch__card p {
    margin: 0 0 0.45rem;
    font-size: 0.92rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .pitch__go {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }

  .pitch__foot {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
</style>
