---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SearchStage from '../components/SearchStage.astro';
import { getCollection } from 'astro:content';
import { pitches, site } from '../site.config';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero" data-hero-tilt>
    <div class="hero__atmosphere" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">作品集 · 数据分析 / AI 产品</p>
        <h1 class="hero__title">{site.name}</h1>
        <p class="hero__tagline">{site.tagline}</p>
        <p class="hero__support">{site.taglineSupport}</p>
        <div class="hero__actions">
          <a class="btn" href="/tour">60 秒导览</a>
          <a class="btn btn--ghost" href="/projects">全部作品</a>
          <a class="btn btn--ghost" href="/resume">下载简历</a>
        </div>
        <p class="hero__pitch">
          按方向：
          <a href={pitches.data.path}>{pitches.data.label}</a>
          ·
          <a href={pitches.ai.path}>{pitches.ai.label}</a>
        </p>
      </div>
      <div class="hero__visual">
        <div class="hero__stage" aria-hidden="true">
          <div class="hero__stage-glow"></div>
          <div class="hero__plate hero__plate--far"></div>
          <div class="hero__plate hero__plate--near"></div>
          <div class="hero__echo">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="hero__stage-main">
            <SearchStage />
          </div>
        </div>
      </div>
    </div>
    <a class="hero__more" href="#cases" aria-label="查看下方项目案例">
      <span class="hero__more-chevron" aria-hidden="true"></span>
    </a>
  </section>

  <section class="section" id="cases">
    <div class="container">
      <div class="section__head reveal">
        <h2>项目案例</h2>
        <a class="section__link" href="/projects">全部作品 →</a>
      </div>
      <div class="grid">
        {
          projects.map((project, index) => (
            <div class="reveal" style={`--reveal-delay: ${80 + index * 70}`}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.25rem, 10vw, 6rem) clamp(4.25rem, 12vw, 7rem);
    background: transparent;
  }

  .hero__more {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0.55;
    transform: translateX(-50%);
    transition: opacity 0.2s ease;
  }

  .hero__more:hover {
    opacity: 0.9;
  }

  .hero__more-chevron {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    animation: hero-more-bob 1.8s ease-in-out infinite;
  }

  @keyframes hero-more-bob {
    0%,
    100% {
      transform: rotate(45deg) translateY(0);
    }
    50% {
      transform: rotate(45deg) translateY(3px);
    }
  }

  .hero__atmosphere {
    display: block;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 85% 20%, rgb(45 212 191 / 22%), transparent 55%),
      radial-gradient(ellipse 50% 45% at 10% 90%, rgb(13 148 136 / 10%), transparent 50%),
      linear-gradient(180deg, #ecfdf5 0%, var(--color-bg) 85%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
  }

  .hero__eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 0.85rem;
    font-size: clamp(2.35rem, 6vw, 3.35rem);
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .hero__tagline {
    max-width: 28rem;
    margin: 0 0 0.65rem;
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.55;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .hero__support {
    margin: 0 0 1.75rem;
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__pitch {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .hero__pitch a {
    font-weight: 500;
    text-decoration: none;
  }

  .hero__pitch a:hover {
    text-decoration: underline;
  }

  .hero__visual {
    min-height: 16rem;
    perspective: 900px;
  }

  .hero__stage {
    position: relative;
    width: min(100%, 26.5rem);
    min-height: 17.5rem;
    margin-inline: auto 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    will-change: transform;
  }

  .hero__stage-glow {
    position: absolute;
    inset: 10% -8% -12% 6%;
    border-radius: 28px;
    background: radial-gradient(ellipse at 50% 40%, rgb(45 212 191 / 26%), transparent 70%);
    filter: blur(20px);
    transform: translateZ(-48px);
    pointer-events: none;
  }

  /* 空白纸片：只做景深，不塞第二套内容 */
  .hero__plate {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: rgb(255 255 255 / 55%);
    border: 1px solid rgb(228 228 224 / 80%);
    pointer-events: none;
  }

  .hero__plate--far {
    transform: translate3d(14%, -10%, -42px) rotate(3.5deg);
    opacity: 0.45;
  }

  .hero__plate--near {
    transform: translate3d(7%, -5%, -22px) rotate(1.75deg);
    opacity: 0.7;
    background: rgb(255 255 255 / 70%);
  }

  /* 侧边淡淡的看板骨架，暗示「搜索后面还有分析」 */
  .hero__echo {
    position: absolute;
    right: -4%;
    bottom: 8%;
    z-index: 0;
    display: grid;
    gap: 0.45rem;
    width: 42%;
    padding: 0.75rem 0.7rem;
    background: rgb(255 255 255 / 72%);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 0 10px 24px rgb(13 148 136 / 6%);
    transform: translateZ(-14px) rotate(4deg);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero__echo span {
    display: block;
    height: 0.4rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #99f6e4, #e7e5e4);
  }

  .hero__echo span:nth-child(1) {
    width: 78%;
  }

  .hero__echo span:nth-child(2) {
    width: 58%;
    opacity: 0.75;
  }

  .hero__echo span:nth-child(3) {
    width: 66%;
    opacity: 0.55;
  }

  .hero__stage-main {
    position: relative;
    z-index: 1;
    transform: translateZ(20px);
  }

  @media (max-width: 899px) {
    .hero__stage {
      width: 100%;
      margin: 0;
    }

    .hero__plate--far {
      transform: translate3d(8%, -6%, -36px) rotate(2.5deg);
    }

    .hero__plate--near {
      transform: translate3d(4%, -3%, -18px) rotate(1.2deg);
    }

    .hero__echo {
      right: 0;
      bottom: 6%;
      width: 36%;
      opacity: 0.4;
    }

    .hero__stage-main {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      transform: none;
      will-change: auto;
    }
  }

  .section {
    padding-block: var(--space-section);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .section__head h2 {
    margin: 0;
    letter-spacing: -0.03em;
  }

  .section__link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .section__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .grid {
    display: grid;
    gap: 1.1rem;
  }

  .grid > .reveal {
    height: 100%;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__more-chevron {
      animation: none;
    }
  }
</style>

<script>
  const hero = document.querySelector('[data-hero-tilt]');
  const stage = hero?.querySelector('.hero__stage');
  const finePointer = window.matchMedia('(pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero instanceof HTMLElement && stage instanceof HTMLElement && finePointer.matches && !reduceMotion.matches) {
    const maxTilt = 8;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let raf = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;
      stage.style.setProperty('--tilt-x', `${currentX.toFixed(2)}deg`);
      stage.style.setProperty('--tilt-y', `${currentY.toFixed(2)}deg`);

      if (Math.abs(targetX - currentX) > 0.02 || Math.abs(targetY - currentY) > 0.02) {
        raf = requestAnimationFrame(render);
      } else {
        stage.style.setProperty('--tilt-x', `${targetX}deg`);
        stage.style.setProperty('--tilt-y', `${targetY}deg`);
        currentX = targetX;
        currentY = targetY;
        raf = 0;
      }
    };

    const kick = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    hero.addEventListener('mousemove', (event) => {
      const rect = hero.getBoundingClientRect();
      const px = (event.clientX - rect.left) / rect.width - 0.5;
      const py = (event.clientY - rect.top) / rect.height - 0.5;
      targetY = px * maxTilt * 2;
      targetX = -py * maxTilt * 2;
      kick();
    });

    hero.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
      kick();
    });
  }
</script>
